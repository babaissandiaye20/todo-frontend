# URL the BROWSER calls the backend on (must be reachable from the user's machine).
# Local dev: backend runs on localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL Server Components / SSR fetch the backend on (runs INSIDE the container).
# Inside Docker, services reach each other by their compose service name (e.g. http://backend:4000).
# Local dev (no Docker): set the same value as NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=http://localhost:4000
